# Copy this file to `.env.local` and fill in your keys. `.env.local` is gitignored.
# All VITE_-prefixed vars are exposed to the browser (that's expected for these).

# Clerk — phone-number (SMS OTP) login for the Chat tab. OPTIONAL:
# leave it unset and the app runs auth-free (Translation works; Chat is open).
# Get this from the Clerk dashboard → API Keys → "Publishable key" (starts with pk_).
VITE_CLERK_PUBLISHABLE_KEY=

# Gemini key is NOT set here — in production it lives server-side as GEMINI_API_KEY
# (Vercel env var, used by api/gemini.js). For local dev you paste a personal key
# in the app's Settings instead. See README.
