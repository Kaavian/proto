# Copy this file to `.env.local` and fill in your keys. `.env.local` is gitignored.
# All VITE_-prefixed vars are exposed to the browser (that's expected for these).

# Clerk — Google sign-in for the Chat tab. OPTIONAL:
# leave it unset and the app runs auth-free (Translation works; Chat is open).
# Get this from the Clerk dashboard → API Keys → "Publishable key" (starts with pk_).
VITE_CLERK_PUBLISHABLE_KEY=

# Web Push — the buddy's daily pings. Client needs the VAPID PUBLIC key (safe to expose).
# Generate a keypair once with:  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Gemini key is NOT set here — in production it lives server-side as GEMINI_API_KEY
# (Vercel env var, used by api/gemini.js). For local dev you paste a personal key
# in the app's Settings instead. See README.
#
# SERVER-ONLY vars (set these in Vercel, NOT here / never VITE_-prefixed):
#   GEMINI_API_KEY      — Google AI Studio key (also used to write the ping messages)
#   VAPID_PRIVATE_KEY   — the private half from `npx web-push generate-vapid-keys`
#   VAPID_SUBJECT       — a contact URL, e.g. mailto:you@example.com
#   CLERK_SECRET_KEY    — Clerk dashboard → API Keys → "Secret key" (sk_...)
#   NUDGE_SECRET        — any long random string; also add it as a GitHub Actions secret
